# Pagar.me V5 Gateway Integration (sk_ and pk_ tokens)
PAGARME_SECRET_KEY=
PAGARME_PUBLIC_KEY=
PAGARME_WEBHOOK_SECRET_KEY=

# Asaas Gateway Integration (inscrições e saques PIX)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_AUTHORIZATION_TOKEN=
ASAAS_ENVIRONMENT=production
PUBLIC_APP_URL=https://invictusperformance.app.br

# Campeonatos oficiais pagos — abertura comercial permanece false até a edição
# estar revisada e todos os campos abaixo publicados.
PAID_CHAMPIONSHIP_REGISTRATION_ENABLED=false

# Musculação
CHAMPIONSHIP_STRENGTH_EDITION=
CHAMPIONSHIP_STRENGTH_REGISTRATION_OPENS_AT=
CHAMPIONSHIP_STRENGTH_REGISTRATION_CLOSES_AT=
CHAMPIONSHIP_STRENGTH_START_AT=
CHAMPIONSHIP_STRENGTH_END_AT=
CHAMPIONSHIP_STRENGTH_SETTLEMENT_AT=
CHAMPIONSHIP_STRENGTH_PRIZES_JSON=

# Cardio
CHAMPIONSHIP_CARDIO_EDITION=
CHAMPIONSHIP_CARDIO_REGISTRATION_OPENS_AT=
CHAMPIONSHIP_CARDIO_REGISTRATION_CLOSES_AT=
CHAMPIONSHIP_CARDIO_START_AT=
CHAMPIONSHIP_CARDIO_END_AT=
CHAMPIONSHIP_CARDIO_SETTLEMENT_AT=
CHAMPIONSHIP_CARDIO_PRIZES_JSON=
CHAMPIONSHIP_CARDIO_ALLOWED_TYPES=

# Frete padrão calculado pelo backend para compras em dinheiro. Use 0 apenas
# quando a operação tiver frete realmente gratuito; Drops 100% Coins devem
# usar frete subsidiado, patrocinado ou campanha grátis.
STORE_DEFAULT_SHIPPING_AMOUNT=0
# Limite opcional de exposição por Drop; o admin ainda pode definir um limite
# menor em cada campanha.
STORE_DROP_MAX_BUDGET=

# RevenueCat (assinaturas iOS e Android)
# Chave secreta usada somente pelo backend para confirmar o entitlement.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=
# Produção é o padrão seguro. Inclua SANDBOX somente em preview/testes isolados.
REVENUECAT_ALLOWED_ENVIRONMENTS=PRODUCTION
# Divergências webhook x REST pedem retry até o primeiro limite (padrões: 5
# tentativas ou 10 minutos); depois disso o snapshot REST é autoritativo.
REVENUECAT_RECONCILIATION_MAX_ATTEMPTS=5
REVENUECAT_RECONCILIATION_MAX_AGE_MS=600000
# Allowlist do backend; informe os IDs iOS/Android separados por vírgula.
REVENUECAT_PERFORMANCE_PRODUCT_IDS=
# Chaves públicas incorporadas em cada build nativo.
VITE_REVENUECAT_ANDROID_API_KEY=
VITE_REVENUECAT_IOS_API_KEY=
# Identificadores explícitos do pacote/produto Performance publicados no
# dashboard. O app não escolhe silenciosamente o primeiro pacote disponível.
VITE_REVENUECAT_PERFORMANCE_PACKAGE_ID=
VITE_REVENUECAT_PERFORMANCE_PRODUCT_ID=
# Overrides opcionais quando Android e iOS usam identificadores diferentes.
VITE_REVENUECAT_ANDROID_PERFORMANCE_PACKAGE_ID=
VITE_REVENUECAT_ANDROID_PERFORMANCE_PRODUCT_ID=
VITE_REVENUECAT_IOS_PERFORMANCE_PACKAGE_ID=
VITE_REVENUECAT_IOS_PERFORMANCE_PRODUCT_ID=

# APNs direto para o aplicativo iOS. A chave .p8 deve ser armazenada como uma
# única variável (quebras de linha podem ser representadas por \n).
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
# production ou sandbox; use production na publicação pela App Store.
APNS_ENVIRONMENT=production

# Cron Endpoint Security
CRON_SECRET=

# Firebase Admin. Use JSON completo somente no ambiente seguro (Vercel/CI),
# nunca em arquivo versionado. Alternativamente use ADC no Google Cloud.
FIREBASE_SERVICE_ACCOUNT=
# Necessário ao backend para verificar a existência/metadados de vídeos
# PowerLift antes de homologar um registro.
FIREBASE_STORAGE_BUCKET=

# Origens extras separadas por vírgula para preview/ambiente controlado.
CORS_ALLOWED_ORIGINS=

# Diagnóstico administrativo desativado por padrão.
ENABLE_ENV_CHECK=false

# Operação destrutiva de manutenção; deixe desativada em produção.
ENABLE_MIGRATE_RESET=false

# AI Model
GEMINI_API_KEY=
# Alias aceito quando a infraestrutura Google já usa este nome.
GOOGLE_API_KEY=
# Opcional. O padrão estável do servidor é gemini-3.6-flash.
GEMINI_TEXT_MODEL=gemini-3.6-flash

# Strava API Integration
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=
STRAVA_SUBSCRIPTION_ID=
STRAVA_REDIRECT_URI=http://localhost:3000/api/app?action=strava&stravaAction=callback

# Google Maps/Places API Integration
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=

# Mapbox: use tokens publicos (pk.) separados para web e builds Capacitor.
# O token web deve ser restrito ao dominio; o mobile deve ter apenas escopos
# publicos de leitura e nao usar restricao de URL.
VITE_MAPBOX_WEB_TOKEN=
VITE_MAPBOX_MOBILE_TOKEN=
MAPBOX_PUBLIC_TOKEN=
