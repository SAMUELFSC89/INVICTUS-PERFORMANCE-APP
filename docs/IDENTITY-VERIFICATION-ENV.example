# Twilio Verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_FRIENDLY_NAME=Invictus

# SERPRO Consulta CPF
SERPRO_CPF_CONSUMER_KEY=
SERPRO_CPF_CONSUMER_SECRET=
# Optional override. Defaults to https://gateway.apiserpro.serpro.gov.br/token
SERPRO_CPF_TOKEN_URL=
# Contract-specific Consulta CPF v3 URL. Must contain both placeholders.
SERPRO_CPF_QUERY_URL_TEMPLATE=https://SEU-ENDPOINT/{cpf}/{birthDate}

# Firebase email branding is configured in Firebase Authentication templates
# and the authorized/custom auth domain, not with a repository secret.
