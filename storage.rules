rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function ownsPath(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isImageUpload() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 10 * 1024 * 1024;
    }

    function isVideoUpload() {
      return request.resource.contentType.matches('video/.*') &&
             request.resource.size < 100 * 1024 * 1024;
    }

    // Avatares. As imagens podem ser lidas apenas por usuários autenticados;
    // a URL de download já compartilhada continua permitindo mostrar avatares
    // em ranking/perfil sem expor o bucket inteiro publicamente.
    match /profiles/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if ownsPath(userId) && isImageUpload();
      allow delete: if ownsPath(userId);
    }

    // Fotos de posts e stories seguem o UID que já é usado pelo app no path.
    match /posts/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if ownsPath(userId) && isImageUpload();
      allow delete: if ownsPath(userId);
    }

    match /stories/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if ownsPath(userId) && isImageUpload();
      allow delete: if ownsPath(userId);
    }

    // O vídeo só pode ser enviado pelo próprio atleta. A aprovação do Power
    // Lift acontece no backend; Storage não concede acesso de escrita a outros
    // caminhos nem ao status do registro no Firestore.
    match /power_records/{userId}/{fileName} {
      allow read: if ownsPath(userId);
      allow create, update: if ownsPath(userId) && isVideoUpload();
      allow delete: if ownsPath(userId);
    }

    // Fail closed para qualquer objeto novo ou legado não listado acima.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
