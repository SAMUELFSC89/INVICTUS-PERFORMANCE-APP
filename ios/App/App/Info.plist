<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>INVICTUS</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.desafiosemdesculpa.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.desafiosemdesculpa.app</string>
				<string>invictus</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>O INVICTUS usa a câmera para registrar comprovantes de treino e vídeos de homologação do Power Lift.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>O Invictus lê, com sua autorização, atividades e métricas de condicionamento, recuperação, sono, coração, respiração, composição corporal, movimento, energia, hidratação e atenção plena para criar seu histórico e relatórios pessoais em linguagem simples. Não acessa medicamentos nem prontuários clínicos.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>O Invictus utiliza o Apple Health para registrar e sincronizar dados das suas atividades físicas, permitindo acompanhar seus treinos, evolução e métricas de desempenho.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>O INVICTUS usa sua localização ao buscar academias, validar treinos presenciais e registrar rotas de cardio ao ar livre enquanto o app está em uso.</string>
	<key>NSMotionUsageDescription</key>
	<string>O INVICTUS lê sensores de movimento durante uma atividade para registrar a telemetria do exercício.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>O INVICTUS acessa sua biblioteca apenas quando você escolher anexar um comprovante ou vídeo.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
