{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://gen-lang-client-0890994677.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/app"
    },
    {
      "source": "/share/:id",
      "destination": "/api/app?action=share&id=:id"
    },
    {
      "source": "/((?!api/|assets/|__/auth/|capacete\\.webp|favicon-16\\.png|favicon-32\\.png|apple-touch-icon\\.png|icon-180\\.png|icon-192\\.png|icon-512\\.png|icon-512-maskable\\.png|brand-share\\.png|manifest\\.json|sw\\.js).*)",
      "destination": "/index.html"
    }
  ],
    "crons": [
        { "path": "/api/audit-fraud", "schedule": "0 6 * * *" },
        { "path": "/api/season-payout-cron", "schedule": "30 6 * * *" },
        { "path": "/api/gym-championship-payout-cron", "schedule": "0 7 1 * *" }
          ]
}
