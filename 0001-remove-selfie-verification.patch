-
-  const presenceCheckId = typeof req.body?.presenceCheckId === 'string' ? req.body.presenceCheckId.trim() : '';
-  const photoBase64 = typeof req.body?.photoBase64 === 'string' ? req.body.photoBase64.trim() : '';
